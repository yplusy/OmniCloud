{
	"name": "Node.js & TypeScript",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-trixie",
	"features": {
		"ghcr.io/devcontainers/features/node:2": {
			"version": "none",
			"pnpmVersion": "latest"
		},
		"ghcr.io/devcontainers/features/git-lfs:1": {}
	},
	// "forwardPorts": [],
	"remoteEnv": {
		"API_KEY": "${localEnv:API_KEY}"
	},
	"postCreateCommand": "pnpm setup && pnpm install -g opencode-ai",
	"customizations": {
		"vscode": {
			"settings": {
				"editor.formatOnSave": true,
				"files.autoSave": "onFocusChange",
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"editor.codeActionsOnSave": {
					"source.fixAll.prettier": "always",
					"source.fixAll.eslint": "always",
					"source.organizeImports": "always"
				},
				"eslint.validate": ["javascript", "typescript", "svelte", "html", "json", "jsonc"],
				"tailwindCSS.emmetCompletions": true,
				"tailwindCSS.includeLanguages": {
					"svelte": "html"
				}
			},
			"extensions": [
				"MS-CEINTL.vscode-language-pack-zh-hans",
				"svelte.svelte-vscode",
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"bradlc.vscode-tailwindcss"
			]
		}
	}
	// "remoteUser": "root"
}
